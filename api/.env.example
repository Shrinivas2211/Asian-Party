# 复制成 api/.env 后填入真实值。api/.env 已被 .gitignore 忽略。

# https://platform.openai.com/api-keys 取得。识别要读图，模型必须支持视觉输入。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 允许跨域的前端地址，逗号分隔。
# 手机真机调试时追加局域网地址，例如：
#   CORS_ORIGINS=http://localhost:5173,http://192.168.1.5:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
