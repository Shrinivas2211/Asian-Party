# 复制成 web/.env.local 后填入真实值。web/.env.local 已被 .gitignore 忽略。
#
# ⚠️ 这里只放 anon key。service_role key 和 OPENAI_API_KEY 绝不能出现在前端 ——
#    所有 VITE_ 前缀的变量都会被打包进 JS，任何访问者都能看到。
#
# 两个值在 Supabase 控制台 → Project Settings → Data API / API Keys 里取。

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# FastAPI 后端地址。手机真机调试时改成局域网地址，例如 http://192.168.1.5:8000
VITE_API_BASE_URL=http://localhost:8000
